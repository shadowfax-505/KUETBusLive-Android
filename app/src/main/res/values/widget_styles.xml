<?xml version="1.0" encoding="utf-8"?>
<!-- Type on the home screen widget, in the three fonts the rider can pick in Profile.
     Every widget layout comes once per font (widget_<size>_<font>.xml), because a widget
     can't change its font from code. -->
<resources>
    <!-- Departure board: condensed capitals like a station board. -->
    <style name="Widget.Board.Label" parent="">
        <item name="android:fontFamily">@font/barlow_condensed_medium</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/widget_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Board.Title" parent="">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Board.Number" parent="">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">44sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Widget.Board.Number.Ring">
        <item name="android:textSize">28sp</item>
    </style>
    <style name="Widget.Board.Number.Time">
        <item name="android:textSize">32sp</item>
    </style>
    <style name="Widget.Board.Stop" parent="">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Board.Small" parent="">
        <item name="android:fontFamily">@font/barlow_condensed_medium</item>
        <item name="android:textColor">@color/widget_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <!-- Space Grotesk: a modern geometric sans. -->
    <style name="Widget.Grotesk.Label" parent="">
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/widget_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Grotesk.Title" parent="">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Grotesk.Number" parent="">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">36sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Widget.Grotesk.Number.Ring">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="Widget.Grotesk.Number.Time">
        <item name="android:textSize">26sp</item>
    </style>
    <style name="Widget.Grotesk.Stop" parent="">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Grotesk.Small" parent="">
        <item name="android:fontFamily">@font/space_grotesk_medium</item>
        <item name="android:textColor">@color/widget_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <!-- Serif and mono: a serif name with monospaced numbers, like a printed timetable. -->
    <style name="Widget.Timetable.Label" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/widget_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Timetable.Title" parent="">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Timetable.Number" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_bold</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Widget.Timetable.Number.Ring">
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Widget.Timetable.Number.Time">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="Widget.Timetable.Stop" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Timetable.Small" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:textColor">@color/widget_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
