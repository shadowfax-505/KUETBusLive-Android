<?xml version="1.0" encoding="utf-8"?>
<!-- Small widget (Timetable font): a ring with the minutes left, and the bus or trip under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_mark"
            android:layout_width="10dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_mark"
            android:tint="@color/widget_primary" />

        <TextView
            android:id="@+id/widget_headline"
            style="@style/Widget.Timetable.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/widget_label" />
    </LinearLayout>

    <!-- Spacer. A widget may only use a few view classes, and plain View isn't one of them. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/widget_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:tint="@color/widget_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_ring_number"
                style="@style/Widget.Timetable.Number.Ring"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/widget_ring_unit"
                style="@style/Widget.Timetable.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Spacer. A widget may only use a few view classes, and plain View isn't one of them. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_title"
        style="@style/Widget.Timetable.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/widget_subtitle"
        style="@style/Widget.Timetable.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp" />
</LinearLayout>
