<?xml version="1.0" encoding="utf-8"?>
<!-- The "Next bus" widget: KUET mark and label, the time in serif, the trip and where it leaves from. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="13dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_mark"
            android:tint="@color/widget_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/widget_label"
            android:textAllCaps="true"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Spacer. A widget may only use a few view classes, and plain View isn't one of them. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/widget_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_trip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/widget_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/widget_secondary"
        android:textSize="10sp" />
</LinearLayout>
