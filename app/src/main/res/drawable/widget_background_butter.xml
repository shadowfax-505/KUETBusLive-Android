<?xml version="1.0" encoding="utf-8"?>
<!-- Butter cream widget: the colour runs top to bottom, a little lighter at the top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/widget_butter_bottom"
        android:startColor="@color/widget_butter_top" />
</shape>
